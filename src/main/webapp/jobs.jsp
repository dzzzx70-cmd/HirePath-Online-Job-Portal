<%@ page contentType="text/html;charset=UTF-8" import="java.util.*,com.hirepath.model.User,com.hirepath.util.Html" %><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Explore jobs | HirePath</title><link rel="stylesheet" href="assets/style.css"></head><body><nav class="nav"><a class="brand" href="index.jsp">Hire<span>Path</span></a><div><a href="jobs">Jobs</a><a href="my-applications">My applications</a><% if(session.getAttribute("user")!=null){ %><form class="inline" method="post" action="logout"><button class="link-btn">Logout</button></form><% }else{ %><a href="login.jsp">Login</a><% } %></div></nav><main class="container"><p class="eyebrow">OPPORTUNITY AWAITS</p><h1>Find your next role.</h1><p class="muted">Search open opportunities and take your next step.</p><form class="search" method="get" action="jobs"><input name="q" placeholder="Job title, company or location" value="<%= Html.escape(request.getParameter("q")) %>"><button class="btn">Search</button></form><% User current=(User)session.getAttribute("user"); if(current!=null && "EMPLOYER".equals(current.role())) { %><section class="panel post-panel"><h2>Post a job</h2><form method="post" action="post-job"><div class="form-grid"><div><label>Job title *</label><input name="title" required></div><div><label>Company *</label><input name="company" required></div><div><label>Location *</label><input name="location" required></div><div><label>Job type</label><select name="jobType"><option>Full-time</option><option>Part-time</option><option>Internship</option><option>Contract</option></select></div></div><label>Description *</label><textarea name="description" required rows="4"></textarea><label>Required skills</label><input name="skills" placeholder="Java, SQL, teamwork"><button class="btn">Publish job</button></form></section><% } %><div class="job-list"><% List<Map<String,Object>> jobs=(List<Map<String,Object>>)request.getAttribute("jobs"); if(jobs==null||jobs.isEmpty()){ %><section class="panel"><h3>No jobs found yet</h3><p class="muted">Register as an employer and post the first opportunity, or try another search.</p></section><% } else { for(Map<String,Object> j:jobs){ %><article class="job-card"><div class="job-top"><div><span class="tag"><%= Html.escape(String.valueOf(j.get("job_type"))) %></span><h2><%= Html.escape(String.valueOf(j.get("title"))) %></h2><p class="company"><%= Html.escape(String.valueOf(j.get("company"))) %> · <%= Html.escape(String.valueOf(j.get("location"))) %></p></div></div><p><%= Html.escape(String.valueOf(j.get("description"))) %></p><p class="muted"><b>Skills:</b> <%= Html.escape(String.valueOf(j.get("required_skills"))) %></p><% if(current!=null && "SEEKER".equals(current.role())) { %><form method="post" action="apply"><input type="hidden" name="jobId" value="<%= j.get("id") %>"><label>Cover letter (optional)</label><textarea name="coverLetter" rows="2" placeholder="Why are you a good fit?"></textarea><button class="btn">Apply now</button></form><% } else if(current==null) { %><a href="login.jsp">Log in to apply →</a><% } %></article><% } } %></div></main></body></html>
