<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Create account | HirePath</title><link rel="stylesheet" href="assets/style.css"></head><body><nav class="nav"><a class="brand" href="index.jsp">Hire<span>Path</span></a><a href="index.jsp">Home</a></nav><main class="form-wrap"><section class="panel"><p class="eyebrow">JOIN HIREPATH</p><h1>Create your account</h1><p class="muted">Start your next chapter today.</p><form method="post" action="register"><label>Full name</label><input name="fullName" required maxlength="100" placeholder="Your name"><label>Email</label><input type="email" name="email" required maxlength="190" placeholder="you@example.com"><label>Password (minimum 8 characters)</label><input type="password" name="password" required minlength="8"><label>Account type</label><select name="role"><option value="SEEKER">Job seeker</option><option value="EMPLOYER">Employer</option></select><button class="btn full">Create account</button></form><p>Already registered? <a href="login.jsp">Log in</a></p></section></main></body></html>
