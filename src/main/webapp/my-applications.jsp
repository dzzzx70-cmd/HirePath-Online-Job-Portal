<%@ page contentType="text/html;charset=UTF-8" import="java.util.*,com.hirepath.util.Html" %><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My applications | HirePath</title><link rel="stylesheet" href="assets/style.css"></head><body><nav class="nav"><a class="brand" href="index.jsp">Hire<span>Path</span></a><div><a href="jobs">Browse jobs</a><form class="inline" method="post" action="logout"><button class="link-btn">Logout</button></form></div></nav><main class="container"><p class="eyebrow">YOUR CAREER JOURNEY</p><h1>My applications</h1><div class="job-list"><% List<Map<String,Object>> apps=(List<Map<String,Object>>)request.getAttribute("applications"); if(apps==null||apps.isEmpty()){ %><section class="panel"><h3>No applications yet</h3><a class="btn" href="jobs">Browse jobs</a></section><% } else { for(Map<String,Object> a:apps){ %><article class="job-card"><span class="tag"><%= Html.escape(String.valueOf(a.get("status"))) %></span><h2><%= Html.escape(String.valueOf(a.get("title"))) %></h2><p class="company"><%= Html.escape(String.valueOf(a.get("company"))) %> · <%= Html.escape(String.valueOf(a.get("location"))) %></p><p class="muted">Applied: <%= Html.escape(String.valueOf(a.get("applied_at"))) %></p></article><% } } %></div></main></body></html>
